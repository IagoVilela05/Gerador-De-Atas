# Chave da API do Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui

# Modelo padrão do Gemini para os Agentes
GEMINI_MODEL=gemini-3.8-flash

# ID da pasta de Atas no Google Drive (opcional, pode ser obtido da URL da pasta no Drive)
